# Database connection string.
#   Local default (no setup needed): sqlite:///./stock_ledger.db
#   PostgreSQL example:              postgresql://ledger:ledger@localhost:5432/ledger
# postgres:// and postgresql:// URLs are normalised to the psycopg3 driver automatically.
DATABASE_URL=sqlite:///./stock_ledger.db

# Comma-separated list of browser origins allowed to call the API (the UI's URL).
CORS_ORIGINS=http://localhost:5173

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Set to "true" to run migrations + seed (only if the DB is empty) when the container starts.
SEED_ON_START=true
